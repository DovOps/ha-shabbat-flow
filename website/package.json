{
  "name": "shabbat-flow-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare-content": "node scripts/prepare-content.mjs",
    "start": "npm run prepare-content && docusaurus start --host 127.0.0.1 --port 3000 --no-open",
    "build": "npm run prepare-content && docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3000 --no-open",
    "check": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "serialize-javascript": "7.1.4",
    "uuid": "11.1.1"
  }
}
